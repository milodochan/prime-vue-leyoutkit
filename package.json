{
  "name": "@layoutkit/prime-vue-layoutkit",
  "version": "0.1.16-dev",
  "main": "dist/prime-vue-layoutkit.cjs.js",
  "module": "dist/prime-vue-layoutkit.es.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/prime-vue-layoutkit.es.js",
      "require": "./dist/prime-vue-layoutkit.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/assets/style.css -o ./dist/style.css --minify",
    "build": "vite build && npm run build:css",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.4",
    "@tailwindcss/cli": "^4.1.18",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "sass": "^1.63.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^5.0.0",
    "primeicons": "^7.0.0", 
    "@primevue/forms": "^4.5.4",
    "@primeuix/themes": "^2.0.2",
    "primevue": "^4.5.4", 
    "vue": "^3.2.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "zod": "^4.3.6"
  }
}
